/*
Signature : void fillBlock(Image& img, unsigned startX, unsigned startY, unsigned blockSize, Pixel color)

Paramètres :
img : l’image à modifier
startX, startY : les coordonnées du coin supérieur gauche du bloc,
blockSize : la taille (carrée) du bloc,
color  : la couleur à appliquer à tous les pixels du bloc

Description : Cette fonction remplit une zone carrée de l’image avec une couleur donnée.

*/

    .data 

    .text 
    .globl fillBlock                      

fillBlock:
    # prologue
    pushl   %ebp                      
    movl    %esp, %ebp     
    pushl %ebx
    pushl %esi
    pushl %edi

    # TODO
    mov 8(%ebp),%eax  #eax prend image
    mov 8(%eax), %edx #Tableau pixel dans edx
    
    mov 16(%ebp), %edi #edi prend y
    #il reste ebx , ecx et edx

    boucle_y:
    mov 12(%ebp), %esi #esi prend x
    cmpl  4(%eax),%edi 
    jae fin_boucle_y #premiere condition -> y >= height 
    movl 16(%ebp), %ebx
    addl 20(%ebp), %ebx
    cmpl %ebx,%edi #deuxieme condition -> y >= startY + block size 
    jae fin_boucle_y

    mov (%edx, %edi, 4),%ecx #on prend la colonne
    jmp boucle_x

    
    boucle_x:
    cmpl  (%eax),%esi #premiere condition -> x >= width 
    jae fin_boucle_x
    movl 12(%ebp), %ebx
    addl 20(%ebp), %ebx
    cmpl %ebx,%esi #x >= startX + block size
    jae fin_boucle_x

    mov 24(%ebp), %ebx
    movl %ebx, (%ecx,%esi,4) #le pixel courant prend le pixel color
    incl %esi

    jmp boucle_x

    fin_boucle_x:

    incl %edi
    jmp boucle_y

    fin_boucle_y:
    popl %edi
    popl %esi
    popl %ebx 
    


    # epilogue
    
    leave 
    ret